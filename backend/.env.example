# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5500

# PostgreSQL Database (Neon Connection String)
DATABASE_URL=postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# GitHub Configuration
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
GITHUB_USERNAME=your_github_name
CLASSWORK_REPO_NAME=your_repo_name
WEBHOOK_SECRET=your_super_secret_webhook_key_here

# Administrative Security Token (For manual sync triggers)
ADMIN_API_KEY=your_secure_admin_api_key_here
